{
  "manifest_version": 3,
  "name": "Ghostly",
  "version": "1.0.0",
  "description": "Ghost mode for Instagram. Watch stories and read messages without leaving a trace. Nothing leaves your browser.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    { "matches": ["https://www.instagram.com/*"], "js": ["ghost.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.instagram.com/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Ghostly",
    "default_icon": { "16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
  },
  "icons": { "16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
}
